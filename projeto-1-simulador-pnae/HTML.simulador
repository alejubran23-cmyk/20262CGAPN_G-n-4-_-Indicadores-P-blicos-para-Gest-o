<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Simulador de Repasse do PNAE</title>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:          #f5f4f0;
  --surface:     #ffffff;
  --surface2:    #eeedea;
  --border:      #d8d6ce;
  --border2:     #c2c0b8;
  --text:        #1a1a18;
  --text2:       #5e5d57;
  --text3:       #9e9d97;
  --blue:        #185fa5;
  --blue-bg:     #e4f0fb;
  --blue-text:   #0c3f7a;
  --green:       #0d7a4f;
  --green-bg:    #d1fae5;
  --green-text:  #065f46;
  --red-bg:      #fde8e8;
  --red-text:    #9b1c1c;
  --warn-bg:     #fffbeb;
  --warn-border: #fcd34d;
  --warn-text:   #78350f;
  --radius:      10px;
  --radius-sm:   6px;
  --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  --mono: 'Cascadia Code', 'Fira Mono', Consolas, 'Courier New', monospace;
}

body {
  font-family: var(--sans);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  padding: 2rem 1.5rem;
  line-height: 1.5;
}

.wrap { max-width: 1040px; margin: 0 auto; }

/* ── INTRO ── */
.intro { margin-bottom: 2rem; }
.intro-headline {
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.2;
  margin-bottom: 0.4rem;
}
.intro-headline em { font-style: italic; color: var(--blue); }
.intro-sub {
  font-size: 0.93rem;
  color: var(--text2);
  line-height: 1.65;
  max-width: 760px;
  margin-bottom: 0.6rem;
}
.intro-sub strong { color: var(--text); font-weight: 600; }
.source-note {
  font-size: 11.5px;
  color: var(--text3);
  max-width: 760px;
  line-height: 1.6;
}

.divider { display: flex; align-items: center; gap: 12px; margin: 2rem 0 1.2rem; }
.divider-line { flex: 1; height: 1px; background: var(--border2); }
.divider-label { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--text3); white-space: nowrap; }

/* ── CARD ── */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.2rem 1.4rem;
  margin-bottom: 1.4rem;
}
.card-title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--text3);
  margin-bottom: 12px;
}
.card-note {
  font-size: 11.5px;
  color: var(--text3);
  margin-top: 10px;
  line-height: 1.6;
}

/* two-column layout */
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media (max-width: 760px) { .grid2 { grid-template-columns: 1fr; } }

/* ── SCHOOL INFO ── */
.school-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}
@media (max-width: 640px) { .school-grid { grid-template-columns: 1fr; } }
.school-item .k { font-size: 11px; color: var(--text3); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 3px; }
.school-item .v { font-size: 15px; font-weight: 600; }

/* ── TABLES ── */
table.data-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
table.data-table th {
  text-align: left;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: var(--text3);
  border-bottom: 2px solid var(--border2);
  padding: 6px 8px;
}
table.data-table td {
  padding: 7px 8px;
  border-bottom: 1px solid var(--border);
  font-family: var(--mono);
}
table.data-table td.label-col { font-family: var(--sans); font-weight: 500; }
table.data-table tr.total-row td { font-weight: 700; border-top: 2px solid var(--border2); border-bottom: none; background: var(--surface2); }
table.data-table tr.total-row td.label-col { font-family: var(--sans); }
table.data-table input[type="number"] {
  width: 84px;
  font-family: var(--mono);
  font-size: 13.5px;
  padding: 5px 7px;
  border: 1px solid var(--border2);
  border-radius: var(--radius-sm);
  background: var(--surface2);
  color: var(--text);
}
table.data-table input[type="number"]:focus { outline: 2px solid var(--blue); outline-offset: -1px; background: var(--surface); }
.num { text-align: right; }

/* ── RESULT ROWS ── */
.result-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 9px 0;
  border-bottom: 1px solid var(--border);
  font-size: 13.5px;
}
.result-row:last-child { border-bottom: none; }
.result-row .k { color: var(--text2); }
.result-row .v { font-family: var(--mono); font-weight: 700; color: var(--text); }
.result-row.hl .v { color: var(--blue-text); font-size: 1.15em; }

.badge {
  display: inline-block;
  font-size: 11.5px;
  font-weight: 700;
  padding: 2px 10px;
  border-radius: 99px;
}
.badge.pequena { background: var(--blue-bg); color: var(--blue-text); }
.badge.media   { background: var(--warn-bg); color: var(--warn-text); border: 1px solid var(--warn-border); }
.badge.grande  { background: var(--green-bg); color: var(--green-text); }
.badge.elegivel   { background: var(--green-bg); color: var(--green-text); }
.badge.inelegivel { background: var(--red-bg); color: var(--red-text); }

/* ── FIELD / FATOR ── */
.field label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: var(--text2);
  margin-bottom: 5px;
}
.field .hint { font-weight: 400; color: var(--text3); font-size: 11px; }
.field input[type="number"] {
  font-family: var(--mono);
  font-size: 15px;
  padding: 8px 10px;
  border: 1px solid var(--border2);
  border-radius: var(--radius-sm);
  background: var(--surface2);
  color: var(--text);
  width: 140px;
}
.field input:focus { outline: 2px solid var(--blue); outline-offset: -1px; background: var(--surface); }
.fator-row { display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
.fator-readout { font-size: 13px; color: var(--text2); }
.fator-readout strong { color: var(--blue-text); font-family: var(--mono); }

/* ── BUTTONS ── */
.btn {
  padding: 8px 18px;
  border-radius: 99px;
  border: 1px solid var(--border2);
  background: var(--surface);
  color: var(--text2);
  font-size: 14px;
  font-weight: 600;
  font-family: var(--sans);
  cursor: pointer;
  transition: background .12s, color .12s, border-color .12s, opacity .12s;
}
.btn:hover { border-color: var(--text2); color: var(--text); }
.btn.primary { background: var(--blue); color: #fff; border-color: var(--blue); }
.btn.primary:hover { background: var(--blue-text); border-color: var(--blue-text); }
.btn:disabled { opacity: .4; cursor: default; }
.btn:disabled:hover { border-color: var(--border2); color: var(--text2); }
.controls { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }

.status { font-size: 13.5px; color: var(--text2); min-height: 20px; line-height: 1.5; margin-bottom: 10px; }
.status strong { color: var(--text); }
.status .done-badge {
  display: inline-block;
  background: var(--green-bg);
  color: var(--green-text);
  font-weight: 700;
  font-size: 11px;
  padding: 2px 9px;
  border-radius: 99px;
  margin-right: 6px;
  vertical-align: middle;
}

/* scenario table row animation */
table.scenario-table tbody tr { animation: fadeIn .35s ease; }
table.scenario-table tbody tr.current-row td { background: var(--blue-bg); }
table.scenario-table tbody tr.base-row td { font-weight: 700; }
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-4px); }
  to   { opacity: 1; transform: translateY(0); }
}

.footnote {
  margin-top: 1.6rem;
  font-size: 12px;
  color: var(--text3);
  line-height: 1.6;
  max-width: 760px;
}
</style>
</head>
<body>
<div class="wrap">

<div class="intro">
  <div class="intro-headline">Simulador de <em>Repasse do PNAE</em></div>
  <div class="intro-sub">
    Simulação do cálculo de repasse do <strong>Programa Nacional de Alimentação Escolar (PNAE)</strong> para uma
    escola municipal, a partir dos valores per capita por modalidade de ensino e da regra de classificação por
    porte. Edite as matrículas e o fator de ajuste abaixo para ver o repasse reagir em tempo real.
  </div>
  <div class="source-note">
    Fonte dos valores per capita e dias letivos: Resolução CD/FNDE nº 1, de 18 de fevereiro de 2026 (altera a
    Resolução CD/FNDE nº 6/2020) — reajuste médio de 14,35% em relação a 2025, em vigor desde a primeira parcela
    de 2026. Escola e matrículas são fictícias, criadas para fins didáticos (Projeto 1 — Análise de Dados para
    Pesquisas em Políticas Públicas, FGV EAESP). O bairro é real, no município de Osasco/SP.
  </div>
</div>

<!-- ═══ PARÂMETROS DO PNAE (referência) ═══ -->
<div class="card">
  <div class="card-title">Parâmetros do PNAE — referência</div>
  <div class="grid2">
    <div>
      <table class="data-table">
        <thead>
          <tr><th>Modalidade</th><th class="num">Valor per capita (R$/dia)</th></tr>
        </thead>
        <tbody id="tbl-parametros"></tbody>
      </table>
      <div class="card-note">Dias letivos considerados por ano: <strong id="txt-dias-ref"></strong></div>
    </div>
    <div>
      <table class="data-table">
        <thead>
          <tr><th>Matrículas (mínimo)</th><th>Porte</th></tr>
        </thead>
        <tbody id="tbl-faixas"></tbody>
      </table>
      <div class="card-note">Faixas criadas para fins didáticos deste curso — não correspondem a um critério oficial de classificação do FNDE.</div>
    </div>
  </div>
</div>

<!-- ═══ DADOS DA ESCOLA ═══ -->
<div class="card">
  <div class="card-title">Dados da escola</div>
  <div class="school-grid">
    <div class="school-item"><div class="k">Nome da escola (fictício)</div><div class="v">EMEB Vila Quitaúna</div></div>
    <div class="school-item"><div class="k">Bairro</div><div class="v">Quitaúna</div></div>
    <div class="school-item"><div class="k">Município</div><div class="v">Osasco/SP</div></div>
  </div>
</div>

<!-- ═══ MATRÍCULAS + RESULTADO ═══ -->
<div class="grid2">

  <div class="card">
    <div class="card-title">Matrículas por modalidade (ano letivo projetado)</div>
    <table class="data-table">
      <thead>
        <tr><th>Modalidade</th><th class="num">Matrículas</th><th class="num">Per capita (R$/dia)</th><th class="num">Contribuição ao repasse</th></tr>
      </thead>
      <tbody id="tbl-matriculas"></tbody>
      <tfoot>
        <tr class="total-row">
          <td class="label-col">Total de Matrículas</td>
          <td class="num" id="cell-total-matriculas">—</td>
          <td></td>
          <td class="num" id="cell-total-repasse-mini">—</td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="card">
    <div class="card-title">Resultado</div>
    <div class="result-row"><span class="k">Total de matrículas</span><span class="v" id="res-total">—</span></div>
    <div class="result-row"><span class="k">Porte da escola</span><span class="v" id="res-porte">—</span></div>
    <div class="result-row"><span class="k">Dias letivos</span><span class="v" id="res-dias">—</span></div>
    <div class="result-row hl"><span class="k">Repasse Anual Estimado (R$)</span><span class="v" id="res-repasse">—</span></div>
    <div class="result-row"><span class="k">Elegibilidade — complementação municipal</span><span class="v" id="res-elegibilidade">—</span></div>
    <div class="card-note">
      Regra de elegibilidade: <strong>Elegível</strong> se o total de matrículas for menor que 201 <strong>E</strong>
      houver ao menos 1 matrícula em Creche <strong>OU</strong> Pré-escola. Regra criada apenas para praticar
      SE aninhado e E/OU — não reproduz nenhum critério oficial de complementação municipal.
    </div>
  </div>

</div>

<div class="divider">
  <div class="divider-line"></div>
  <span class="divider-label">Simule com o fator de ajuste</span>
  <div class="divider-line"></div>
</div>

<!-- ═══ SIMULAÇÃO COM FATOR DE AJUSTE (tempo real) ═══ -->
<div class="card">
  <div class="card-title">Modelo para simulação — fator de ajuste em tempo real</div>
  <div class="fator-row">
    <div class="field">
      <label for="in-fator">Fator de Ajuste <span class="hint">ex.: 10 = +10%, -10 = -10%</span></label>
      <input type="number" id="in-fator" value="0" step="1">
    </div>
    <div class="fator-readout">Aplicado sobre as matrículas base como <strong id="txt-fator-formula">matrículas × (1 + 0)</strong></div>
  </div>
  <table class="data-table">
    <thead>
      <tr><th>Modalidade</th><th class="num">Matrículas base</th><th class="num">Matrículas ajustadas</th><th class="num">Per capita (R$/dia)</th><th class="num">Contribuição ajustada</th></tr>
    </thead>
    <tbody id="tbl-simulacao"></tbody>
    <tfoot>
      <tr class="total-row">
        <td class="label-col">Total de Matrículas e Repasse</td>
        <td></td>
        <td class="num" id="cell-sim-total-matriculas">—</td>
        <td></td>
        <td class="num" id="cell-sim-total-repasse">—</td>
      </tr>
    </tfoot>
  </table>
</div>

<div class="divider">
  <div class="divider-line"></div>
  <span class="divider-label">Tabela de dados — cenários de variação</span>
  <div class="divider-line"></div>
</div>

<!-- ═══ STEPPER DE CENÁRIOS (Tabela de Dados do Excel) ═══ -->
<div class="card">
  <div class="card-title">Percorrendo os cenários da Tabela de Dados</div>
  <div class="card-note" style="margin-top:0; margin-bottom:12px;">
    Reproduz a Tabela de Dados (Dados → Teste de Hipótese → Tabela de Dados) construída na planilha, variando o
    Fator de Ajuste de -20% a +20% em passos de 5 pontos percentuais, sobre as matrículas base atuais da escola.
  </div>
  <div class="controls">
    <button class="btn" onclick="resetScenarios()">&#x21BA; Reiniciar cenários</button>
    <button class="btn primary" id="btn-scenario-step" onclick="stepScenario()">Próximo cenário &rarr;</button>
  </div>
  <div class="status" id="scenario-status">Clique em <strong>"Próximo cenário"</strong> para começar a reconstruir a tabela, do fator mais negativo ao mais positivo.</div>
  <table class="data-table scenario-table">
    <thead>
      <tr><th>Fator de Variação</th><th class="num">Total de Matrículas</th><th class="num">Repasse Anual (R$)</th></tr>
    </thead>
    <tbody id="tbl-scenarios"></tbody>
  </table>
</div>

<div class="footnote">
  Ferramenta didática construída para o Projeto 1 do curso Análise de Dados para Pesquisas em Políticas Públicas
  (FGV EAESP), a partir de um modelo em Excel com as abas Parametros_PNAE e Simulador_Escola. Os valores per
  capita, os dias letivos e a fórmula de cálculo do repasse (SUMPRODUCT de matrículas × valor per capita × dias
  letivos) reproduzem a Resolução CD/FNDE nº 1/2026; a escola, as matrículas e as regras de porte/elegibilidade
  são fictícias/didáticas.
</div>

</div>

<script>
// ── DADOS BASE (Parametros_PNAE) ──
var MODALIDADES = [
  { key: 'creche',    label: 'Creche',               percapita: 1.57 },
  { key: 'pre',       label: 'Pré-escola',            percapita: 0.82 },
  { key: 'fund',      label: 'Fundamental',           percapita: 0.57 },
  { key: 'medio',     label: 'Médio',                 percapita: 0.57 },
  { key: 'eja',       label: 'EJA',                   percapita: 0.57 },
  { key: 'indigena',  label: 'Indígena/Quilombola',   percapita: 0.98 },
  { key: 'aee',       label: 'AEE (contraturno)',     percapita: 0.78 }
];
var DIAS_LETIVOS = 200;
var FAIXAS = [
  { min: 0,   label: 'Pequena' },
  { min: 201, label: 'Média' },
  { min: 401, label: 'Grande' }
];
var MATRICULAS_INICIAIS = { creche: 60, pre: 80, fund: 50, medio: 0, eja: 0, indigena: 0, aee: 0 };
var SCENARIO_FACTORS = [-0.20, -0.15, -0.10, -0.05, 0, 0.05, 0.10, 0.15, 0.20];

function fmtBRL(v) {
  return v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
}
function fmtPct(v) {
  var s = (v * 100).toFixed(0);
  return (v >= 0 ? '+' : '') + s + '%';
}

function getPorte(total) {
  var result = FAIXAS[0].label;
  for (var i = 0; i < FAIXAS.length; i++) {
    if (total >= FAIXAS[i].min) result = FAIXAS[i].label;
  }
  return result;
}
function porteBadgeClass(porte) {
  if (porte === 'Pequena') return 'pequena';
  if (porte === 'Média') return 'media';
  return 'grande';
}

// ── RENDER TABELAS DE REFERÊNCIA (estáticas) ──
function renderReferenceTables() {
  var tbody = document.getElementById('tbl-parametros');
  tbody.innerHTML = '';
  MODALIDADES.forEach(function(m) {
    var tr = document.createElement('tr');
    tr.innerHTML = '<td class="label-col">' + m.label + '</td><td class="num">' + m.percapita.toFixed(2).replace('.', ',') + '</td>';
    tbody.appendChild(tr);
  });
  document.getElementById('txt-dias-ref').textContent = DIAS_LETIVOS;

  var tbodyF = document.getElementById('tbl-faixas');
  tbodyF.innerHTML = '';
  FAIXAS.forEach(function(f, idx) {
    var proxLimite = FAIXAS[idx + 1] ? (FAIXAS[idx + 1].min - 1) : null;
    var faixaTexto = proxLimite ? (f.min + ' a ' + proxLimite) : (f.min + ' ou mais');
    var tr = document.createElement('tr');
    tr.innerHTML = '<td class="label-col">' + faixaTexto + '</td><td><span class="badge ' + porteBadgeClass(f.label) + '">' + f.label + '</span></td>';
    tbodyF.appendChild(tr);
  });
}

// ── LEITURA DAS MATRÍCULAS EDITÁVEIS ──
function readMatriculas() {
  var m = {};
  MODALIDADES.forEach(function(mod) {
    var el = document.getElementById('in-mat-' + mod.key);
    var v = parseInt(el.value, 10);
    m[mod.key] = isNaN(v) || v < 0 ? 0 : v;
  });
  return m;
}

function computeBase(matriculas) {
  var total = 0, repasse = 0;
  MODALIDADES.forEach(function(m) {
    total += matriculas[m.key];
    repasse += matriculas[m.key] * m.percapita;
  });
  repasse *= DIAS_LETIVOS;
  var porte = getPorte(total);
  var elegivel = (total < 201) && (matriculas.creche > 0 || matriculas.pre > 0);
  return { total: total, repasse: repasse, porte: porte, elegivel: elegivel };
}

// ── RENDER TABELA DE MATRÍCULAS (editável) + RESULTADO ──
function renderMatriculasTable() {
  var matriculas = readMatriculas();
  var tbody = document.getElementById('tbl-matriculas');
  tbody.innerHTML = '';
  MODALIDADES.forEach(function(m) {
    var contrib = matriculas[m.key] * m.percapita * DIAS_LETIVOS;
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td class="label-col">' + m.label + '</td>' +
      '<td class="num"><input type="number" min="0" step="1" id="in-mat-' + m.key + '" value="' + matriculas[m.key] + '" onchange="onMatriculasChange()"></td>' +
      '<td class="num">' + m.percapita.toFixed(2).replace('.', ',') + '</td>' +
      '<td class="num">' + fmtBRL(contrib) + '</td>';
    tbody.appendChild(tr);
  });

  var base = computeBase(matriculas);
  document.getElementById('cell-total-matriculas').textContent = base.total;
  document.getElementById('cell-total-repasse-mini').textContent = fmtBRL(base.repasse);

  document.getElementById('res-total').textContent = base.total;
  document.getElementById('res-porte').innerHTML = '<span class="badge ' + porteBadgeClass(base.porte) + '">' + base.porte + '</span>';
  document.getElementById('res-dias').textContent = DIAS_LETIVOS;
  document.getElementById('res-repasse').textContent = fmtBRL(base.repasse);
  document.getElementById('res-elegibilidade').innerHTML = base.elegivel
    ? '<span class="badge elegivel">Elegível</span>'
    : '<span class="badge inelegivel">Inelegível</span>';

  return matriculas;
}

function onMatriculasChange() {
  renderMatriculasTable();
  renderSimulationTable();
}

// ── SIMULAÇÃO COM FATOR DE AJUSTE (tempo real) ──
function readFator() {
  var el = document.getElementById('in-fator');
  var v = parseFloat(el.value);
  if (isNaN(v)) v = 0;
  return v / 100;
}

function renderSimulationTable() {
  var matriculasBase = readMatriculas();
  var fator = readFator();
  document.getElementById('txt-fator-formula').textContent = 'matrículas × (1 + ' + fator.toFixed(2).replace('.', ',') + ')';

  var tbody = document.getElementById('tbl-simulacao');
  tbody.innerHTML = '';
  var totalAjustado = 0, repasseAjustado = 0;
  MODALIDADES.forEach(function(m) {
    var base = matriculasBase[m.key];
    var ajustada = base * (1 + fator);
    var contrib = ajustada * m.percapita * DIAS_LETIVOS;
    totalAjustado += ajustada;
    repasseAjustado += contrib;
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td class="label-col">' + m.label + '</td>' +
      '<td class="num">' + base + '</td>' +
      '<td class="num">' + ajustada.toLocaleString('pt-BR', { maximumFractionDigits: 1 }) + '</td>' +
      '<td class="num">' + m.percapita.toFixed(2).replace('.', ',') + '</td>' +
      '<td class="num">' + fmtBRL(contrib) + '</td>';
    tbody.appendChild(tr);
  });

  document.getElementById('cell-sim-total-matriculas').textContent = totalAjustado.toLocaleString('pt-BR', { maximumFractionDigits: 1 });
  document.getElementById('cell-sim-total-repasse').textContent = fmtBRL(repasseAjustado);
}

// ── STEPPER DE CENÁRIOS (Tabela de Dados) ──
var scenarioBase, scenarioIdx;

function resetScenarios() {
  scenarioBase = readMatriculas();
  scenarioIdx = 0;
  document.getElementById('tbl-scenarios').innerHTML = '';
  document.getElementById('btn-scenario-step').disabled = false;
  document.getElementById('scenario-status').innerHTML =
    'Cenários prontos para a base atual (total de ' + computeBase(scenarioBase).total + ' matrículas). Clique em <strong>"Próximo cenário"</strong> para começar.';
}

function stepScenario() {
  if (scenarioIdx >= SCENARIO_FACTORS.length) return;
  var factor = SCENARIO_FACTORS[scenarioIdx++];

  var total = 0, repasse = 0;
  MODALIDADES.forEach(function(m) {
    var ajustada = scenarioBase[m.key] * (1 + factor);
    total += ajustada;
    repasse += ajustada * m.percapita * DIAS_LETIVOS;
  });

  var tbody = document.getElementById('tbl-scenarios');
  // remove highlight from previous row
  var prev = tbody.querySelector('tr.current-row');
  if (prev) prev.classList.remove('current-row');

  var tr = document.createElement('tr');
  tr.className = 'current-row' + (factor === 0 ? ' base-row' : '');
  tr.innerHTML =
    '<td class="label-col">' + fmtPct(factor) + (factor === 0 ? ' (cenário-base)' : '') + '</td>' +
    '<td class="num">' + total.toLocaleString('pt-BR', { maximumFractionDigits: 1 }) + '</td>' +
    '<td class="num">' + fmtBRL(repasse) + '</td>';
  tbody.appendChild(tr);

  document.getElementById('scenario-status').innerHTML =
    'Cenário <strong>' + fmtPct(factor) + '</strong>: total de matrículas ' +
    total.toLocaleString('pt-BR', { maximumFractionDigits: 1 }) + ', repasse anual estimado ' +
    '<strong>' + fmtBRL(repasse) + '</strong>.';

  if (scenarioIdx >= SCENARIO_FACTORS.length) {
    document.getElementById('btn-scenario-step').disabled = true;
    document.getElementById('scenario-status').innerHTML =
      '<span class="done-badge">&#10003; Concluído</span> Todos os ' + SCENARIO_FACTORS.length + ' cenários da Tabela de Dados foram reconstruídos.';
  }
}

// ── INIT ──
function init() {
  MODALIDADES.forEach(function(m) {
    // placeholder to guarantee initial values exist before first render
  });
  renderReferenceTables();

  // seed initial matriculas into a temp state before first table render
  window._initialMatriculas = MATRICULAS_INICIAIS;
  renderMatriculasTableInitial();
  renderSimulationTable();
  resetScenarios();
}

function renderMatriculasTableInitial() {
  var tbody = document.getElementById('tbl-matriculas');
  tbody.innerHTML = '';
  MODALIDADES.forEach(function(m) {
    var val = MATRICULAS_INICIAIS[m.key];
    var contrib = val * m.percapita * DIAS_LETIVOS;
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td class="label-col">' + m.label + '</td>' +
      '<td class="num"><input type="number" min="0" step="1" id="in-mat-' + m.key + '" value="' + val + '" onchange="onMatriculasChange()"></td>' +
      '<td class="num">' + m.percapita.toFixed(2).replace('.', ',') + '</td>' +
      '<td class="num">' + fmtBRL(contrib) + '</td>';
    tbody.appendChild(tr);
  });
  var base = computeBase(MATRICULAS_INICIAIS);
  document.getElementById('cell-total-matriculas').textContent = base.total;
  document.getElementById('cell-total-repasse-mini').textContent = fmtBRL(base.repasse);
  document.getElementById('res-total').textContent = base.total;
  document.getElementById('res-porte').innerHTML = '<span class="badge ' + porteBadgeClass(base.porte) + '">' + base.porte + '</span>';
  document.getElementById('res-dias').textContent = DIAS_LETIVOS;
  document.getElementById('res-repasse').textContent = fmtBRL(base.repasse);
  document.getElementById('res-elegibilidade').innerHTML = base.elegivel
    ? '<span class="badge elegivel">Elegível</span>'
    : '<span class="badge inelegivel">Inelegível</span>';
}

document.getElementById('in-fator').addEventListener('input', renderSimulationTable);

init();
</script>
</body>
</html>
